generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  CANCELED
}

enum TaskKind {
  TASK
  BUG
  IMPROVEMENT
  FEATURE
  DECISION
  EXTERNAL_REQUEST
  FUTURE_IDEA
  QUESTION
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  ACHIEVED
  POSTPONED
  CANCELED
}

enum InboxStatus {
  RECEIVED
  TRANSCRIBING
  ANALYZING
  AWAITING_CONFIRMATION
  PROCESSED
  DISCARDED
  ERROR
}

enum InboxSource {
  TEXT
  AUDIO
  TRELLO
  MCP
  SPREADSHEET
}

enum ContextCategory {
  FACT
  DECISION
  RULE
  VOCABULARY
  MEETING
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AiRunStatus {
  RECEIVED
  TRANSCRIBING
  TRANSCRIBED
  ORGANIZING
  AWAITING_MARKDOWN_APPROVAL
  RETRIEVING_REFERENCES
  MATERIALIZING
  AWAITING_ENTITY_APPROVAL
  EXECUTING
  PROCESSED
  FAILED
  DISCARDED
}

enum AiRunStep {
  TRANSCRIBING
  ORGANIZING
  RETRIEVING_REFERENCES
  MATERIALIZING
  EXECUTING
  CLEANING_AUDIO
}

enum TranscriptSource {
  TEXT
  STT
}

enum AiRevisionSource {
  AI
  USER
}

enum AiApprovalType {
  MARKDOWN
  ENTITIES
}

enum AiExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProposalOperation {
  CREATE
  LINK
}

enum ProposalEntityType {
  TASK
  MEETING
  NOTE
  MILESTONE
  PROJECT
  ALIAS
  MODULE
  TAG
  CONTEXT
  DEPENDENCY
  TASK_MILESTONE
}

model Project {
  id          String          @id @default(cuid())
  ownerId     String
  name        String
  description String          @default("")
  color       String          @default("#68d7a7")
  priority    Priority        @default(P3)
  status      ProjectStatus   @default(ACTIVE)
  aliases     ProjectAlias[]
  modules     ProjectModule[]
  tags        ProjectTag[]
  contexts    ProjectContext[]
  notes       Note[]
  tasks       Task[]
  milestones  Milestone[]
  meetings    Meeting[]
  attachments Attachment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([ownerId, name])
}

model ProjectAlias {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())

  @@unique([projectId, value])
}

model ProjectModule {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  terms     String[] @default([])
  tasks     Task[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

/// Etiqueta do card, sempre dentro de um projeto: o vocabulário de um projeto não
/// vale no outro (PRD 24, "Contexto de projetos diferentes se misturar").
model ProjectTag {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#68d7a7")
  tasks     TaskTag[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Task {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  moduleId     String?
  module       ProjectModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title        String
  description  String           @default("")
  kind         TaskKind         @default(TASK)
  status       TaskStatus       @default(BACKLOG)
  priority     Priority         @default(P3)
  complexity   Int?
  dueAt        DateTime?
  forecastAt   DateTime?
  sourceInboxId String?         @unique
  source        InboxItem?      @relation("InboxTask", fields: [sourceInboxId], references: [id], onDelete: SetNull)
  sourceNoteId String?          @unique
  sourceNote   Note?            @relation("NoteTask", fields: [sourceNoteId], references: [id], onDelete: SetNull)
  milestones   TaskMilestone[]
  tags         TaskTag[]
  contexts     ProjectContext[]
  notes        Note[]           @relation("NoteCard")
  dependsOn    TaskDependency[] @relation("DependentTask")
  blocks       TaskDependency[] @relation("BlockingTask")
  attachments  Attachment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([taskId, dependsOnId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String          @default("")
  startAt     DateTime?
  targetAt    DateTime
  status      MilestoneStatus @default(PLANNED)
  tasks       TaskMilestone[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TaskMilestone {
  taskId      String
  milestoneId String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([taskId, milestoneId])
}

/// Nota privada: fora de IA e MCP por decisão da Fase 0. Toda nota pertence a um
/// projeto; `taskId` é o vínculo voluntário com um card e não se confunde com
/// `convertedTask`, que é o card nascido desta nota.
model Note {
  id            String   @id @default(cuid())
  ownerId       String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?    @relation("NoteCard", fields: [taskId], references: [id], onDelete: SetNull)
  title         String
  content       String
  pinned        Boolean  @default(false)
  /// Ordem do arraste na tela. Float para caber um ponto médio entre vizinhos.
  position      Float    @default(0)
  convertedTask Task?    @relation("NoteTask")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([projectId])
}

model ProjectContext {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title     String
  content   String
  category  ContextCategory @default(FACT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InboxItem {
  id          String      @id @default(cuid())
  ownerId     String
  source      InboxSource @default(TEXT)
  status      InboxStatus @default(RECEIVED)
  text        String
  suggestion  Json?
  createdTask Task?       @relation("InboxTask")
  aiRuns      AiRun[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  dedupeKey   String?   @unique
  ownerId     String?
  aiRunId     String?
  aiRun       AiRun?    @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  step        AiRunStep?
  inputVersion Int?
  inputHash   String?
  priority    Int       @default(0)
  leaseExpiresAt DateTime?
  heartbeatAt DateTime?
  timeoutMs   Int?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([aiRunId])
  @@index([status, priority, runAt])
}

model Meeting {
  id              String   @id @default(cuid())
  ownerId         String
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  description     String   @default("")
  startsAt        DateTime
  endsAt          DateTime?
  durationMinutes Int?
  timezone        String
  link            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId, startsAt])
  @@index([projectId])
}

model AiRun {
  id                       String                   @id @default(cuid())
  ownerId                  String
  inboxItemId              String
  inboxItem                InboxItem                @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  status                   AiRunStatus              @default(RECEIVED)
  version                  Int                      @default(0)
  failedStep               AiRunStep?
  errorCode                String?
  retryable                Boolean                  @default(false)
  activeTranscriptId       String?
  activeMarkdownRevisionId String?
  activeProposalRevisionId String?
  transcripts              TranscriptRevision[]
  markdownRevisions        MarkdownRevision[]
  retrievalSnapshots       RetrievalSnapshot[]
  proposalRevisions        ProposalRevision[]
  approvals                AiApproval[]
  executions               AiExecution[]
  attempts                 AiCallAttempt[]
  jobs                     Job[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  discardedAt              DateTime?
  processedAt              DateTime?

  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
  @@index([inboxItemId, createdAt])
}

model TranscriptRevision {
  id              String           @id @default(cuid())
  aiRunId         String
  aiRun           AiRun            @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  version         Int
  text            String
  contentHash     String
  source          TranscriptSource
  provider        String?
  model           String?
  language        String?
  durationMs      Int?
  inputBytes      Int
  tokenCount      Int
  speakerSegments Json?
  timestamps      Json?
  createdAt       DateTime         @default(now())

  @@unique([aiRunId, version])
}

model MarkdownRevision {
  id               String             @id @default(cuid())
  aiRunId          String
  aiRun            AiRun              @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  version          Int
  parentRevisionId String?
  parentRevision   MarkdownRevision?  @relation("MarkdownRevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions   MarkdownRevision[] @relation("MarkdownRevisionParent")
  source           AiRevisionSource
  content          String
  contentHash      String
  tokenCount       Int
  topics           Json               @default("[]")
  promptVersion    String?
  model            String?
  approvedAt       DateTime?
  retrievalSnapshots RetrievalSnapshot[]
  proposalRevisions ProposalRevision[]
  createdAt        DateTime           @default(now())

  @@unique([aiRunId, version])
}

model RetrievalSnapshot {
  id                 String             @id @default(cuid())
  aiRunId            String
  aiRun              AiRun              @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  markdownRevisionId String
  markdownRevision   MarkdownRevision   @relation(fields: [markdownRevisionId], references: [id], onDelete: Cascade)
  queryVersion       String
  contentHash        String
  candidates         Json
  proposalRevisions  ProposalRevision[]
  createdAt          DateTime           @default(now())

  @@index([aiRunId, createdAt])
  @@index([markdownRevisionId])
}

model ProposalRevision {
  id                  String             @id @default(cuid())
  aiRunId             String
  aiRun               AiRun              @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  markdownRevisionId  String
  markdownRevision    MarkdownRevision   @relation(fields: [markdownRevisionId], references: [id], onDelete: Cascade)
  retrievalSnapshotId String
  retrievalSnapshot   RetrievalSnapshot @relation(fields: [retrievalSnapshotId], references: [id], onDelete: Cascade)
  version             Int
  parentRevisionId    String?
  parentRevision      ProposalRevision?  @relation("ProposalRevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions      ProposalRevision[] @relation("ProposalRevisionParent")
  source              AiRevisionSource
  schemaVersion       Int
  rawOutput           Json?
  validatedPlan       Json
  contentHash         String
  promptVersion       String?
  provider            String?
  model               String?
  inputTokens         Int?
  outputTokens        Int?
  latencyMs           Int?
  approvedAt          DateTime?
  items               ProposalItem[]
  execution           AiExecution?
  createdAt           DateTime           @default(now())

  @@unique([aiRunId, version])
  @@index([markdownRevisionId])
  @@index([retrievalSnapshotId])
}

model ProposalItem {
  id                    String             @id @default(cuid())
  proposalRevisionId    String
  proposalRevision      ProposalRevision   @relation(fields: [proposalRevisionId], references: [id], onDelete: Cascade)
  localKey              String
  entityType            ProposalEntityType
  operation             ProposalOperation
  payload               Json
  dependsOn             String[]           @default([])
  evidence              Json
  confidence            Json
  duplicateCandidates   Json
  selected              Boolean            @default(true)
  userEdited            Boolean            @default(false)
  origins               EntityOrigin[]
  createdAt             DateTime           @default(now())

  @@unique([proposalRevisionId, localKey])
}

model AiApproval {
  id         String         @id @default(cuid())
  aiRunId    String
  aiRun      AiRun          @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  ownerId    String
  type       AiApprovalType
  targetId   String
  targetHash String
  createdAt  DateTime       @default(now())

  @@unique([type, targetId])
  @@index([ownerId, createdAt])
  @@index([aiRunId])
}

model AiExecution {
  id                 String            @id @default(cuid())
  aiRunId            String
  aiRun              AiRun             @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  proposalRevisionId String            @unique
  proposalRevision   ProposalRevision  @relation(fields: [proposalRevisionId], references: [id], onDelete: Cascade)
  status             AiExecutionStatus @default(PENDING)
  idempotencyKey    String             @unique
  startedAt          DateTime?
  completedAt        DateTime?
  errorCode          String?
  createdAt          DateTime          @default(now())

  @@index([aiRunId, createdAt])
}

model EntityOrigin {
  id             String             @id @default(cuid())
  proposalItemId String
  proposalItem   ProposalItem       @relation(fields: [proposalItemId], references: [id], onDelete: Cascade)
  entityType     ProposalEntityType
  entityId       String
  createdAt      DateTime           @default(now())

  @@unique([entityType, entityId])
  @@index([proposalItemId])
}

model AiCallAttempt {
  id                String    @id @default(cuid())
  aiRunId           String
  aiRun             AiRun     @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  step              AiRunStep
  attempt           Int
  provider          String
  model             String
  promptVersion     String?
  inputHash         String
  providerRequestId String?
  inputTokens       Int?
  outputTokens      Int?
  latencyMs         Int?
  estimatedCost     Decimal?  @db.Decimal(14, 6)
  technicalResult   String
  errorCode         String?
  createdAt         DateTime  @default(now())

  @@unique([aiRunId, step, attempt])
  @@index([aiRunId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
