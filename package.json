{
  "name": "central-de-projetos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --experimental-https",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file=.env.local src/server/jobs/worker-cli.ts",
    "worker:once": "tsx --env-file=.env.local src/server/jobs/run-once-cli.ts",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx --env-file=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.4.2-beta",
    "@phosphor-icons/react": "^2.1.7",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
