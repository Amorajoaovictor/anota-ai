NEON_AUTH_BASE_URL="https://SEU-PROJETO.auth.neon.tech"
NEON_AUTH_COOKIE_SECRET="gere-um-segredo-com-ao-menos-32-caracteres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require&channel_binding=require"

# Dono da base de demonstração gravada por `npm run db:seed`.
# Vazio: o seed reaproveita o primeiro dono já presente no banco.
SEED_OWNER_ID=""

# Anexos
STORAGE_DRIVER="local"
STORAGE_DIR="var/storage"
MAX_UPLOAD_BYTES="26214400"

# Fila de jobs (IA, transcrição, lembretes)
JOBS_RUNNER_TOKEN="gere-um-token-com-ao-menos-16-caracteres"
JOBS_BATCH_SIZE="10"
JOBS_LOCK_TIMEOUT_MS="300000"
JOBS_POLL_INTERVAL_MS="1000"

# Agente contextual (Fase 4). LLM e STT são escolhidos separadamente.
# "heuristic"/"none" rodam sem chave, casando o texto contra projeto/alias/módulo/tag
# reais do banco. Trocar por outro provedor é estender `server/ai/config.ts`.
LLM_PROVIDER="heuristic"
STT_PROVIDER="none"

# DeepSeek — classificação real (LLM_PROVIDER="deepseek")
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Groq — transcrição real de áudio (STT_PROVIDER="groq")
GROQ_API_KEY=""
GROQ_STT_MODEL="whisper-large-v3-turbo"

# Harness v2. Master switch desligado por padrao.
# Fail-closed: OWNER_IDS vazio desabilita o v2 para todos; inclua explicitamente cada owner aprovado.
AI_HARNESS_V2_ENABLED="false"
AI_HARNESS_V2_OWNER_IDS=""
AI_HARNESS_MAX_PROPOSAL_ITEMS="100"
AI_HARNESS_MAX_MARKDOWN_CHARACTERS="50000"
AI_HARNESS_MAX_AUDIO_BYTES="26214400"

# Timeouts cancelaveis por etapa
AI_HARNESS_TRANSCRIPTION_TIMEOUT_MS="300000"
AI_HARNESS_ORGANIZATION_TIMEOUT_MS="60000"
AI_HARNESS_RETRIEVAL_TIMEOUT_MS="30000"
AI_HARNESS_MATERIALIZATION_TIMEOUT_MS="90000"
AI_HARNESS_CLEANUP_TIMEOUT_MS="30000"

# Orcamentos de tokens; reservas somadas precisam ser menores que o contexto.
AI_HARNESS_ORGANIZER_CONTEXT_TOKENS="64000"
AI_HARNESS_ORGANIZER_SYSTEM_TOKENS="2000"
AI_HARNESS_ORGANIZER_OUTPUT_TOKENS="8000"
AI_HARNESS_ORGANIZER_SAFETY_TOKENS="2000"
AI_HARNESS_MATERIALIZER_CONTEXT_TOKENS="64000"
AI_HARNESS_MATERIALIZER_SYSTEM_TOKENS="3000"
AI_HARNESS_MATERIALIZER_OUTPUT_TOKENS="8000"
AI_HARNESS_MATERIALIZER_REFERENCE_TOKENS="8000"
AI_HARNESS_MATERIALIZER_SAFETY_TOKENS="2000"

# Limiares do health owner-scoped
AI_HARNESS_ALERT_BACKLOG="50"
AI_HARNESS_ALERT_OLDEST_JOB_MS="300000"
AI_HARNESS_ALERT_NO_WORKER_GRACE_MS="60000"
